{
  "name": "@aurora-effect/simulator",
  "version": "0.1.0",
  "description": "Core simulation library for the Aurora Effect galactic settlement simulator",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "dev": "tsc --watch"
  },
  "keywords": [
    "simulation",
    "space",
    "fermi-paradox",
    "aurora-effect"
  ],
  "author": "lbsa71",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "vitest": "^1.2.0"
  }
}
